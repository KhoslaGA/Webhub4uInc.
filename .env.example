# Webhub4U — environment variables
# Copy to .env.local for dev, or set these in the Vercel project settings.
# Everything is optional: unset vars degrade gracefully (analytics stays
# dormant, leads log to the server console instead of being delivered).

# --- Analytics (Sprint 0) -------------------------------------------------
# GA4 Measurement ID. Analytics stays dormant until this is set.
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID — powers 2027 ad conversions + retargeting.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API token (server-side). With this set, lead conversions
# are sent server-side too, deduped with the browser Pixel via event_id —
# recovers the ~30% of conversions lost to ITP/ad-blockers. Uses the Pixel ID
# above (or set META_PIXEL_ID to override).
META_CAPI_TOKEN=
# META_PIXEL_ID=   # optional server-only override for the CAPI pixel id

# --- Lead delivery (Sprint 1) ---------------------------------------------
# GoHighLevel inbound-webhook URL. If set, /api/demo-request forwards leads
# here (GHL-shaped payload) first; on a rejection or 6 s timeout it falls back
# to email. With neither set, both lead APIs answer 503 (never false success).
GHL_WEBHOOK_URL=
# Resend email delivery. /api/sendEmail needs it; /api/demo-request uses it as
# the fallback. Set in Vercel as a Sensitive variable; never commit a value.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. The resend.dev testing
# sender is for testing only and cannot be relied on to reach other inboxes.
EMAIL_FROM="Webhub4U <onboarding@resend.dev>"
EMAIL_TO=webhub4u@gmail.com

# --- Ads & booking (Sprint 5) ---------------------------------------------
# GoHighLevel (or any) calendar embed URL. When set, a self-booking section
# appears on /contact and the /lp ad pages. Unset = no booking section.
NEXT_PUBLIC_GHL_CALENDAR_URL=
# Call-tracking number shown ONLY on the /lp ad pages (NAP-safe DNI). The
# canonical business phone in JSON-LD/citations stays business.js. Unset =
# ad pages use the normal business phone.
NEXT_PUBLIC_LP_TRACKING_PHONE=
